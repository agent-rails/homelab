[
  {
    "id": "basic_arithmetic",
    "prompt": "What is 12 + 30? Answer with just the number.",
    "must_contain": ["42"]
  },
  {
    "id": "instruction_following_format",
    "prompt": "Reply with exactly the single word: pineapple",
    "must_contain": ["pineapple"]
  },
  {
    "id": "refuses_fabrication",
    "prompt": "What is the population of the fictional city of Zorblatt-9? If you don't know, say you don't know.",
    "must_contain": ["don't know", "no information", "not aware", "fictional", "not real"]
  },
  {
    "id": "tool_call_read_file",
    "prompt": "Read the file /tmp/notes.txt and tell me what's in it.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "Read a file from the local filesystem",
          "parameters": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"]
          }
        }
      }
    ],
    "must_call_tool": "read_file"
  },
  {
    "id": "tool_call_bash",
    "prompt": "Run `ls -la` in the terminal and show me the output.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "bash",
          "description": "Execute a shell command",
          "parameters": {
            "type": "object",
            "properties": { "command": { "type": "string" } },
            "required": ["command"]
          }
        }
      }
    ],
    "must_call_tool": "bash"
  },
  {
    "id": "no_tool_when_not_needed",
    "prompt": "What's the capital of France?",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "Read a file from the local filesystem",
          "parameters": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"]
          }
        }
      }
    ],
    "must_contain": ["paris"],
    "must_not_call_tool": "read_file"
  }
]
