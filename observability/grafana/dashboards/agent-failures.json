          },
          "expr": "sum by (hook_event, outcome) (increase(agent_hook_executions_total{outcome=~\"blocking|non_blocking_error|cancelled\",repo=~\"$repo\",tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{hook_event}} {{outcome}}",
          "range": true
