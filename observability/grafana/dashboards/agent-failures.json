    {
      "id": 20,
      "type": "timeseries",
      "title": "Claude Code active time and derived API requests",
      "description": "Pass-through active time summed across sessions next to event-derived API requests. Activity without requests fires the missing-events alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum without(session_id) (rate(claude_code_active_time_seconds_total[$__rate_interval]))",
          "legendFormat": "active time",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(agent_api_requests_total[$__rate_interval]))",
