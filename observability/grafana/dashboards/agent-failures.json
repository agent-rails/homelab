        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_type) (increase(agent_tool_results_total{success=\"false\",repo=~\"$repo\",tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
