    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Hook blocking decisions and errors",
      "description": "blocking is a hook denial; non_blocking_error is a hook that failed without stopping the tool call and fires an alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
