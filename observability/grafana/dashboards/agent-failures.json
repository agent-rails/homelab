      "type": "timeseries",
      "title": "Classifier unavailable or no verdict",
      "description": "Decisions made while the permission classifier returned no verdict. Any value fires the classifier alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (classifier_verdict) (increase(agent_tool_decisions_total{classifier_verdict=~\"unavailable|no_verdict\",repo=~\"$repo\",tenant=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{classifier_verdict}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
