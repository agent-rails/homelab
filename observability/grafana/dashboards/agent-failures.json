        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Collector and Prometheus write errors",
      "description": "Delta conversion errors by reason (limit means dropped streams), Prometheus WAL write failures and out-of-order scraped samples.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 15,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error) (increase(otelcol_deltatocumulative_datapoints{error!=\"\"}[$__rate_interval]))",
          "legendFormat": "delta {{error}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(prometheus_tsdb_wal_writes_failed_total[$__rate_interval]))",
