          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(prometheus_target_scrapes_sample_out_of_order_total[$__rate_interval]))",
