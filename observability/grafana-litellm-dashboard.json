{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric_total[5m]))",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "title": "Requests by model",
      "type": "timeseries"
    },
    {
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(litellm_proxy_failed_requests_metric_total[5m])) / clamp_min(sum(rate(litellm_proxy_total_requests_metric_total[5m])), 0.000000001)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, requested_model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p50 {{requested_model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, requested_model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p95 {{requested_model}}",
          "refId": "B"
        }
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "sum by (requested_model) (rate(litellm_total_tokens_metric_total[5m]))",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "title": "Tokens per second",
      "type": "timeseries"
    },
    {
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "expr": "sum by (requested_model) (increase(litellm_spend_metric_total[24h]))",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "title": "Spend in the last 24 hours",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["litellm", "routing"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "LiteLLM Routing",
  "uid": "litellm-routing",
  "version": 1
}
