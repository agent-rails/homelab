apiVersion: v1
kind: Secret
metadata:
  name: litellm-secrets
  namespace: ai-infra
type: Opaque
stringData:
  LITELLM_MASTER_KEY: "sk-<generate via: openssl rand -hex 32, prefix sk->"
  # LITELLM_SALT_KEY must be base64 (openssl rand -base64 32), NOT hex: it is the
  # Fernet key LiteLLM uses to encrypt virtual keys before storing them in Postgres
  # (Phase 2). A non-base64 salt fails key encryption. Must stay stable across
  # restarts or every previously stored virtual key becomes undecryptable.
  LITELLM_SALT_KEY: "<generate via: openssl rand -base64 32, must stay stable across restarts>"
  # Phase 2: points LiteLLM at its dedicated Postgres (litellm-postgres service).
  # Password half must match litellm-postgres-secrets POSTGRES_PASSWORD.
  DATABASE_URL: "postgresql://litellm:<POSTGRES_PASSWORD>@litellm-postgres:5432/litellm"
