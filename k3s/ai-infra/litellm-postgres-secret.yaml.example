apiVersion: v1
kind: Secret
metadata:
  name: litellm-postgres-secrets
  namespace: ai-infra
type: Opaque
stringData:
  # Dedicated Postgres for the LiteLLM virtual-key + spend store (Phase 2).
  # NOT shared with buzz-postgresql -- DESIGN.md considered and rejected that
  # coupling. Real value applied directly to the live cluster, never committed.
  POSTGRES_PASSWORD: "<generate via: openssl rand -hex 24>"
